---
import { SITE } from "@/config/site";
---

<section id="dove-siamo" class="flex flex-col relative py-20">
  <div
    class="w-[90%] m-auto flex flex-col lg:flex-row justify-between mx-auto gap-3"
  >
    <div class="flex flex-col gap-4 pb-8 lg:w-1/2">
      <h2 class="section-title mb-4">Dove siamo</h2>
      <h3 class="section-subtitle text-darkBlue mb-4">
        Siamo ad Agliana, tra Prato e Pistoia, vicini all&apos;uscita
        dell&apos;autostrada A11
      </h3>
      <div class="flex items-center gap-1 text-darkBlue">
        <span aria-hidden="true" class="grid place-content-center">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"
            ></path><circle cx="12" cy="10" r="2"></circle>
          </svg>
        </span>
        <p class="text-lg font-sans">
          {SITE.address.display}
        </p>
      </div>
      <div class="flex items-center gap-1">
        <span aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>
          </svg>
        </span>
        <p class="text-lg font-sans">Lunedì - Venerdì 15:00 - 19:00</p>
      </div>
      <div class="flex items-center text-secondary font-bold">
        <a
          id="mapLink"
          class="inline-flex gap-1"
          href={SITE.address.directionsUrl}
        >
          <span
            class="bg-opacity-0 border-none grid place-content-center cursor-pointer"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M14 4h6v6M20 4 10 14"></path><path
                d="M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6"
              ></path>
            </svg>
          </span>
          <p class="text-lg font-sans">Come raggiungerci</p>
        </a>
      </div>
    </div>
    <div
      class="flex min-h-80 w-full items-center justify-center rounded-2xl bg-secondaryLight p-8 text-center lg:w-1/2"
    >
      <div class="max-w-md text-darkBlue">
        <svg
          aria-hidden="true"
          class="mx-auto mb-5"
          viewBox="0 0 24 24"
          width="42"
          height="42"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"
          ></path><circle cx="12" cy="10" r="2"></circle>
        </svg>
        <h3 class="text-2xl font-bold">Apri la posizione su Google Maps</h3>
        <p class="mt-3 leading-relaxed">
          La mappa non viene caricata automaticamente, così la pagina resta più
          veloce e non contatta Google senza una tua azione.
        </p>
        <a
          href={SITE.address.directionsUrl}
          target="_blank"
          rel="noreferrer noopener"
          class="blue-cta mt-6 inline-flex"
        >
          APRI GOOGLE MAPS
        </a>
      </div>
    </div>
  </div>
</section>
