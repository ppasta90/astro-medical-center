---
import { FAQS } from "@/data/faqs";
---

<section id="faq" class="bg-secondary flex flex-col relative py-20">
  <div class="flex flex-col justify-between w-[90%] m-auto gap-4 text-white">
    <h2 class="section-title mb-4">FAQ</h2>
    <h3 class="section-subtitle">Hai qualche dubbio?</h3>
    <p>Qui trovi tutte le nostre risposte alle domande più frequenti</p>
    <div class="mt-4 flex flex-col">
      {
        FAQS.map(({ question, answer }, index) => (
          <details
            class="group border-b border-primaryLight/40 py-5"
            open={index === 0}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-bold text-white marker:content-none">
              {question}
              <svg
                aria-hidden="true"
                class="h-6 w-6 shrink-0 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="pt-4 text-lg leading-relaxed text-white">{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
