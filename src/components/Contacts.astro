---
import office from "../images/ufficio1.webp";
import { Picture } from "astro:assets";
import { SITE } from "@/config/site";
---

<section id="contatti" class="bg-primaryLight py-20">
  <div class="w-[90%] mx-auto flex flex-col lg:flex-row gap-12 lg:gap-20">
    <Picture
      src={office}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[480, 768, 1024]}
      sizes="(min-width: 1024px) 45vw, 90vw"
      quality={65}
      alt="Ambiente del Centro Medico Agliana"
      loading="lazy"
      decoding="async"
      class="w-full rounded-lg object-cover lg:w-[45%]"
    />
    <div class="flex flex-col gap-4 h-full">
      <h2 class="section-title mb-4">Contatti</h2>
      <h3 class="section-subtitle">
        Hai bisogno di informazioni o vuoi prenotare?
      </h3>
      <div class="flex gap-4 justify-between font-sans">
        <div class="flex flex-col gap-4">
          <p>
            Per prenotare una visita, consulta la sezione <a
              href="/specializzazioni"
              class="font-bold text-secondary underline underline-offset-4"
              >Specialisti</a
            > e scegli il professionista di tuo interesse. Nella sua scheda troverai,
            quando disponibili, il numero di telefono o il link diretto a Doctolib
            da utilizzare per la prenotazione.
          </p>
          <a
            aria-label="Scrivici una mail"
            href={`mailto:${SITE.contact.email}`}
            target="_blank"
            class="flex gap-2"
          >
            <span class="flex items-center text-secondary" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path><path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>
            <span>{SITE.contact.email}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
