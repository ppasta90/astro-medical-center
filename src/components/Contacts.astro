---
import reception from "../images/segreteria.webp";
import { Picture } from "astro:assets";
import { SITE } from "@/config/site";
---

<section id="contatti" class="bg-primaryLight py-20">
  <div class="w-[90%] mx-auto flex flex-col lg:flex-row gap-12 lg:gap-20">
    <Picture
      src={reception}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={[480, 768, 1024]}
      sizes="(min-width: 1024px) 45vw, 90vw"
      quality={65}
      alt="bancone segreteria centro medico"
      loading="lazy"
      decoding="async"
      class="w-full rounded-lg object-cover lg:w-[45%]"
    />
    <div class="flex flex-col gap-4 h-full">
      <h2 class="section-title mb-4">Contatti</h2>
      <h3 class="section-subtitle">
        Hai bisogno di informazioni o vuoi prenotare?
      </h3>
      <div class="flex gap-4 justify-between font-sans">
        <div class="flex flex-col gap-4">
          <p>
            La nostra segreteria è aperta <b
              >dal lunedi al venerdì dalle ore 15:00 alle 19:00</b
            >. Per prenotazioni e informazioni non esitare a contattarci oppure
            vieni a trovarci, la nostra segreteria sarà lieta di aiutarti.
          </p>
          <a
            aria-label="Scrivici una mail"
            href={`mailto:${SITE.contact.email}`}
            target="_blank"
            class="flex gap-2"
          >
            <span class="flex items-center text-secondary" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 5h16v14H4z"></path><path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>
            <span>{SITE.contact.email}</span>
          </a>
          <a
            aria-label={SITE.contact.phone.ariaLabel}
            href={SITE.contact.phone.href}
            class="flex gap-2"
          >
            <span class="flex items-center text-secondary" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z"
                ></path>
              </svg>
            </span>
            <span>{SITE.contact.phone.display}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
