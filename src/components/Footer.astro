---
import logo from "../images/logo.svg";
import { Image } from "astro:assets";
import { SITE } from "@/config/site";
---

<footer class="bg-primaryLight px-0 pb-28 pt-8 md:pb-8">
  <div class="flex flex-col md:flex-row justify-between w-[90%] m-auto gap-4">
    <div class="flex flex-col gap-4">
      <a aria-label="logo Centro Medico Agliana" href="/" class="mb-8">
        <Image src={logo} alt="Centro Medico Agliana Logo" loading="lazy" />
      </a>
      <div class="flex flex-col gap-4 text-secondary">
        <div class="text-sm">
          <p class="font-bold">
            {SITE.company.legalName}
          </p>

          <p>Partita IVA: {SITE.company.vatNumber}</p>
          <p>Numero REA {SITE.company.reaNumber}</p>
          <a
            aria-label="Scrivici una mail pec"
            href={`mailto:${SITE.contact.pec}`}
          >
            PEC: {SITE.contact.pec}
          </a>
        </div>
      </div>
      <div class="text-sm text-secondary">
        <p>{SITE.address.display}</p>
        <a
          aria-label={SITE.contact.phone.ariaLabel}
          href={SITE.contact.phone.href}
        >
          {SITE.contact.phone.display}
        </a>
        <p>{SITE.contact.email}</p>
        <p>{SITE.openingHours}</p>
      </div>
    </div>
    <div>
      <div
        class="flex flex-col gap-4 font-[1.2rem] text-secondary md:justify-between h-full"
      >
        <div id="socials-icons" class="flex gap-4">
          <a
            aria-label="Facebook"
            href="https://www.facebook.com/studiomedicoagliana"
            target="_blank"
            rel="noreferrer noopener"
          >
            <span aria-hidden="true" class="text-xl font-bold">f</span>
          </a>
          <a
            aria-label="Instagram"
            href="https://www.instagram.com/centromedicoagliana/"
            target="_blank"
            rel="noreferrer noopener"
          >
            <span aria-hidden="true" class="text-2xl">◎</span>
          </a>
          <a
            aria-label="Linkedin"
            href="https://www.linkedin.com/company/centro-medico-agliana/"
            target="_blank"
            rel="noreferrer noopener"
          >
            <span aria-hidden="true" class="text-lg font-bold">in</span>
          </a>
          <a
            href={SITE.booking.widgetUrl}
            target="_blank"
            rel="noreferrer noopener"
            id="booking-button"
            aria-label="Prenota un appuntamento online su Doctolib"
            class="fixed bottom-4 right-4 z-40 inline-flex min-h-12 items-center rounded-full bg-[#107aca] px-5 text-sm font-bold text-white shadow-lg"
          >
            <span>Prenota su Doctolib</span></a
          >
        </div>

        <div id="policies" class="flex flex-col text-sm">
          <a
            href="https://www.iubenda.com/privacy-policy/34164499"
            target="_blank"
            rel="noreferrer noopener"
            title="Privacy Policy">Privacy Policy</a
          >
          <a
            href="https://www.iubenda.com/privacy-policy/34164499/cookie-policy"
            target="_blank"
            rel="noreferrer noopener"
            title="Cookie Policy">Cookie Policy</a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
