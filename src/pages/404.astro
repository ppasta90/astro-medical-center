---
import { Image } from "astro:assets";
import Analytics from "@/components/Analytics.astro";
import logo from "../images/logo.svg";
import "../styles/globals.css";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Analytics />
    <meta name="robots" content="noindex, follow" />
    <meta
      name="description"
      content="La pagina richiesta non è disponibile sul sito del Centro Medico Agliana."
    />
    <link rel="icon" href="/favicon.ico" />
    <title>Pagina non trovata - Centro Medico Agliana</title>
  </head>
  <body class="bg-gray-100 h-screen flex flex-col items-center justify-center">
    <div class="text-center">
      <Image
        src={logo}
        alt="Centro Medico Agliana Logo"
        class="m-auto px-6"
        width={1024}
        height={1024}
      />
      <h1
        class="text-xl md:text-2xl lg:text-4xl font-bold text-secondary mb-6 mt-6"
      >
        La pagina che stai cercando non esiste
      </h1>

      <a href="/" class="green-cta !py-3">Torna alla home</a>
    </div>
  </body>
</html>
