---
import Layout from "../layouts/Layout.astro";
import { capitalizeFirstLetter } from "@/lib/utils";
import { SITE } from "@/config/site";
import { getDoctors } from "@/lib/doctors";
import type { Doctor } from "@/types/doctor";

export async function getStaticPaths() {
  const doctors = await getDoctors();

  return doctors.map((doctor) => ({
    params: { slug: doctor.slug },
    props: { doctor },
  }));
}

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const pageTitle = `${doctor.honorific} ${doctor.name} ${doctor.surname} - ${doctor.professionTitle}`;
const pageDescription = `${doctor.honorific} ${doctor.name} ${doctor.surname}, ${doctor.professionTitle} presso il Centro Medico Agliana. Prenota una visita online o chiama per informazioni.`;
const physicianStructuredData = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "@id": `${SITE.url}/${doctor.slug}#physician`,
  name: `${doctor.honorific} ${doctor.name} ${doctor.surname}`,
  honorificPrefix: doctor.honorific,
  jobTitle: doctor.professionTitle,
  description: doctor.bio,
  image: `${SITE.url}/${doctor.image}`,
  url: `${SITE.url}/${doctor.slug}`,
  medicalSpecialty: doctor.specialization,
  telephone: SITE.contact.phone.e164,
  worksFor: {
    "@id": `${SITE.url}/#medical-clinic`,
  },
  ...(doctor.link ? { sameAs: [doctor.link] } : {}),
};
---

<Layout
  pageDescription={pageDescription}
  pageTitle={pageTitle}
  socialImage={`/${doctor.image}`}
  socialImageAlt={`Foto di ${doctor.honorific} ${doctor.name} ${doctor.surname}`}
  ogType="profile"
  structuredData={physicianStructuredData}
>
  <section class="bg-secondary pt-32 pb-20">
    <!-- Header Section -->
    <div class="w-[90%] m-auto mb-12">
      <div class="flex flex-col md:flex-row items-center gap-8 mb-8">
        <!-- Picture Left -->
        <div class="flex-shrink-0 flex justify-center">
          <img
            src={`/${doctor.image}`}
            alt={`Foto di ${doctor.honorific} ${doctor.name} ${doctor.surname}`}
            class="w-72 h-72 rounded-3xl object-cover"
            width="288"
            height="288"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <!-- Info Right -->
        <div class="flex-grow text-center md:text-left">
          <h1 class="section-title text-center md:text-left mb-4">
            {doctor.honorific}
            {doctor.name}
            {doctor.surname}
          </h1>
          <h2 class="section-subtitle text-white text-center md:text-left mb-8">
            {doctor.professionTitle}
          </h2>
          {
            doctor.link === "" && (
              <p class="text-white text-center md:text-left mb-8 underline">
                Prenotazione online non disponibile, chiamaci per prenotare
              </p>
            )
          }
          <!-- Call to Action Buttons -->
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start"
          >
            {
              doctor.link && (
                <a
                  href={doctor.link}
                  target="_blank"
                  rel="noreferrer"
                  class="green-cta"
                >
                  PRENOTA ONLINE
                </a>
              )
            }
            <!-- Mobile only CHIAMA ORA button -->
            <a href={SITE.contact.phone.href} class="white-cta block sm:hidden">
              CHIAMA ORA
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="w-[90%] m-auto">
      <!-- Bio Section -->
      <div class="mb-12">
        <h3 class="section-title mb-6">Esperienze</h3>
        <div class="bg-secondaryLight rounded-lg p-8">
          <p class="text-darkBlue leading-relaxed whitespace-pre-line text-lg">
            {doctor.bio}
          </p>
        </div>
      </div>

      <!-- Services Section -->
      {
        doctor.services && doctor.services.length > 0 && (
          <div class="mb-12">
            <h3 class="section-title mb-6">Servizi</h3>
            <div class="bg-secondaryLight rounded-lg p-8">
              <ul class="list-disc list-inside text-darkBlue space-y-3 text-lg">
                {doctor.services.map((service) => (
                  <li>{capitalizeFirstLetter(service)}</li>
                ))}
              </ul>
            </div>
          </div>
        )
      }

      <!-- Navigation -->
      <div class="text-center mt-16">
        <a
          href="/specializzazioni"
          class="inline-flex items-center text-primaryLight font-bold hover:underline text-xl font-serif"
        >
          ← Torna alla lista degli specialisti
        </a>
      </div>
    </div>
  </section>
</Layout>
