---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";
import { SITE } from "@/config/site";
import reception from "../images/segreteria.webp";
---

<Layout
  pageTitle="Lavora con noi - Centro Medico Agliana"
  pageDescription="Scopri le opportunità di collaborazione con il Centro Medico Agliana e invia il tuo curriculum per entrare nel nostro team."
>
  <section class="bg-white py-20 min-h-screen">
    <div class="w-[90%] mx-auto">
      <div class="text-center mb-16">
        <h1
          class="text-4xl lg:text-6xl font-bold text-secondary mb-6 font-display"
        >
          Lavora con noi
        </h1>
        <div class="w-20 h-1 bg-primary mx-auto mb-8"></div>
      </div>

      <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">
        <Picture
          src={reception}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 45vw, 90vw"
          quality={65}
          alt="Centro Medico Agliana - Opportunità di lavoro"
          loading="lazy"
          decoding="async"
          class="w-full rounded-lg object-cover lg:w-[45%]"
        />

        <div class="flex flex-col gap-6 h-full lg:w-[55%]">
          <h2
            class="text-2xl lg:text-3xl font-bold text-secondary mb-4 font-display"
          >
            Unisciti al nostro team
          </h2>

          <div class="space-y-6 text-gray-700 font-sans leading-relaxed">
            <p>
              Il <strong>Centro Medico Agliana</strong> è sempre alla ricerca di professionisti
              qualificati e motivati che condividano la nostra missione di fornire
              cure mediche di eccellenza ai nostri pazienti.
            </p>

            <p>
              Cerchiamo medici specialisti, personale sanitario e amministrativo
              che vogliano far parte di un ambiente di lavoro stimolante e
              collaborativo, dove la professionalità e l'attenzione al paziente
              sono i nostri valori fondamentali.
            </p>

            <p>
              Se sei interessato a collaborare con noi, inviaci il tuo
              curriculum vitae. Saremo lieti di valutare la tua candidatura e di
              conoscerti meglio.
            </p>
          </div>

          <div class="mt-8">
            <h3 class="text-xl font-bold text-secondary mb-6 font-display">
              Contattaci per opportunità di collaborazione
            </h3>

            <div class="space-y-4">
              <a
                aria-label="Invia il tuo CV via email"
                href={`mailto:${SITE.contact.email}?subject=Candidatura - Lavora con noi`}
                target="_blank"
                class="flex items-center gap-3 text-gray-700 hover:text-primaryDark transition-colors duration-200"
              >
                <span
                  class="flex items-center text-secondary"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M4 5h16v14H4z"></path><path d="m4 7 8 6 8-6"
                    ></path>
                  </svg>
                </span>
                <span>{SITE.contact.email}</span>
              </a>

              <a
                aria-label="Chiama per informazioni"
                href={SITE.contact.phone.href}
                class="flex items-center gap-3 text-gray-700 hover:text-primaryDark transition-colors duration-200"
              >
                <span
                  class="flex items-center text-secondary"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.33 1.85.56 2.81.69A2 2 0 0 1 22 16.92z"
                    ></path>
                  </svg>
                </span>
                <span>{SITE.contact.phone.display}</span>
              </a>

              <div class="mt-6 p-4 bg-primaryLight rounded-lg">
                <p class="text-sm text-gray-600">
                  <strong>Orari di contatto:</strong><br />
                  Dal lunedì al venerdì dalle ore 15:00 alle 19:00
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
