---
import Layout from "../layouts/Layout.astro";
import RenderCardsList from "@/components/RenderCardsList";
const pageTitle =
  "I nostri specialisti: Dermatologia, Ginecologia, Oculistica e altre specializzazioni";
---

<Layout
  pageTitle={pageTitle}
  pageDescription="I nostri medici specialisti in Dermatologia, Ginecologia, Oculistica e altre specializzazioni presso il Centro Medico Agliana."
>
  <section class="bg-secondary py-20">
    <h1 class="text-primary text-center font-serif text-[80px] pb-6 pt-6">
      I NOSTRI SPECIALISTI
    </h1>
    <h2
      class="text-white text-center font-sans text-3xl font-bold pb-12 px-4 max-w-4xl mx-auto"
    >
      Dermatologia, Ginecologia, Oculistica e altre specializzazioni
    </h2>
    <p
      class="text-2xl text-center leading-9 font-sans text-white pb-20 px-4 md:px-20 max-w-5xl mx-auto"
    >
      I nostri <strong>medici specialisti</strong>, operanti in vari ambiti
      della medicina, sono
      <strong>professionisti altamente qualificati e competenti</strong>.
    </p>
    <RenderCardsList isMainPage={false} client:load />
  </section>
</Layout>
