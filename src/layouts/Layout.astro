---
import Footer from "@/components/Footer.astro";
import Analytics from "@/components/Analytics.astro";
import Header from "@/components/Header.astro";
import { SITE } from "@/config/site";
import { normalizePathname } from "@/lib/routes";
import { getImage } from "astro:assets";
import socialImageSource from "@/images/esterno1.webp";
import "@/styles/globals.css";
import "@fontsource-variable/dm-sans";
import "@fontsource/bebas-neue";
const pathname = normalizePathname(Astro.url.pathname);

interface Props {
  pageDescription?: string;
  pageTitle?: string;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: "website" | "profile";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  pageDescription,
  pageTitle,
  socialImage,
  socialImageAlt = "Ingresso del Centro Medico Agliana",
  ogType = "website",
  structuredData,
} = Astro.props;

const defaultDescription =
  "Studi medici con sede ad Agliana, specializzati in ginecologia, ortopedia, dermatologia, psicologia, osteopatia, senologia, urologia e podologia.";

const titles: { [key: string]: string } = {
  "/": "Centro Medico Agliana - Studi medici specialistici ad Agliana",
  "/specializzazioni": "Centro Medico Agliana - I nostri specialisti",
};

let title = titles[pathname as string];
if (!title && pathname !== "/" && pathname !== "/specializzazioni") {
  title = "Centro Medico Agliana - Dettagli Specialista";
}
title = title || "Centro Medico Agliana";

// Use dynamic title if provided, otherwise use the default
const finalTitle = pageTitle || title;

const canonical = new URL(pathname, Astro.site ?? SITE.url).toString();
const optimizedSocialImage = await getImage({
  src: socialImageSource,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "webp",
  quality: 75,
});
const defaultSocialImageUrl = new URL(
  optimizedSocialImage.src,
  Astro.site ?? SITE.url,
).toString();
const socialImageUrl = socialImage
  ? new URL(socialImage, SITE.url).toString()
  : defaultSocialImageUrl;

const clinicStructuredData = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "@id": `${SITE.url}/#medical-clinic`,
  name: SITE.name,
  legalName: SITE.company.legalName,
  url: SITE.url,
  image: defaultSocialImageUrl,
  telephone: SITE.contact.phone.e164,
  email: SITE.contact.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.streetAddress,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: SITE.address.latitude,
    longitude: SITE.address.longitude,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "15:00",
      closes: "19:00",
    },
  ],
  sameAs: SITE.socialProfiles,
};
const pageStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const structuredDataJson = JSON.stringify([
  clinicStructuredData,
  ...pageStructuredData,
]).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Analytics />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={pageDescription ?? defaultDescription} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Centro Medico Agliana" />
    {
      pathname === "/" ? (
        <meta
          name="facebook-domain-verification"
          content="r666v27b4i86vgmhj9t0crylzc84yc"
        />
      ) : null
    }
    <meta
      name="keywords"
      content="centro medico agliana, ginecologia, ortopedia, dermatologia, psicologia, osteopatia, senologia, urologia, podologia"
    />
    <meta property="og:title" content={finalTitle} />
    <meta
      property="og:description"
      content={pageDescription ?? defaultDescription}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta
      name="twitter:description"
      content={pageDescription ?? defaultDescription}
    />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{finalTitle}</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
  </head>
  <body>
    <main style="overflow-y: hidden;">
      <Header pathname={pathname} />
      <slot />
      <Footer />
    </main>
  </body>
</html>
